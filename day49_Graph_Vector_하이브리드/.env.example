OPENAI_API_KEY=your_openai_api_key
TYPESAFE_API_KEY=your_typesafe_api_key
TYPESAFE_MODEL=jev-1.13.0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_practice_database_password
# 교안 02: 공유 DB는 실제 조회 전용 계정 사용
# Community 실습은 독립 학습 DB 계정을 사용합니다. 변수명은 권한을 제한하지 않습니다.
NEO4J_READONLY_USERNAME=your_readonly_username
NEO4J_READONLY_PASSWORD=your_readonly_password
