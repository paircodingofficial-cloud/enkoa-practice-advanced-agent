# 앞 단원의 OpenAI 설정을 재사용합니다. 저장소 최상위 .env 에 있으면 여기 다시 적지 않아도 됩니다.
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-luna
# 평가용 LLM(선택). 코드 기본값이 gpt-6-luna라 적지 않아도 됩니다. 바꿀 때는 이 단원 폴더의 .env에만 적습니다.
# ragas 0.4.3은 gpt-5.6-luna처럼 버전에 소수점이 든 이름에서 요청 오류가 납니다.
OPENAI_EVAL_MODEL=gpt-6-luna
# ragas가 익명 사용 통계를 외부 서버로 보내지 않게 합니다.
RAGAS_DO_NOT_TRACK=true
