{
 "source_id": "GL-2026",
 "title": "사내 PT 작성 원칙",
 "clauses": [
  {
   "clause_id": "G-1",
   "audiences": [
    "임원회의",
    "팀회의"
   ],
   "text": "첫 장표에 결론과 요청 사항을 먼저 씁니다."
  },
  {
   "clause_id": "G-2",
   "audiences": [
    "임원회의"
   ],
   "text": "임원회의 발표는 10분 기준 슬라이드 8장 이내로 합니다."
  },
  {
   "clause_id": "G-3",
   "audiences": [
    "팀회의"
   ],
   "text": "팀회의 공유는 3분 기준 슬라이드 3장 이내로 합니다."
  },
  {
   "clause_id": "G-4",
   "audiences": [
    "임원회의",
    "팀회의"
   ],
   "text": "모든 수치 옆에 괄호로 출처 ID를 적습니다."
  },
  {
   "clause_id": "G-5",
   "audiences": [
    "임원회의",
    "팀회의"
   ],
   "text": "확인되지 않은 수치는 쓰지 않습니다. 추정치는 추정이라고 표시하고 근거를 적습니다."
  },
  {
   "clause_id": "G-6",
   "audiences": [
    "임원회의"
   ],
   "text": "경쟁사 자료는 확인일이 90일 이내인 것만 근거로 쓰고, 지난 자료는 재확인 필요로 표시합니다."
  },
  {
   "clause_id": "G-7",
   "audiences": [
    "임원회의"
   ],
   "text": "승인이 필요한 사항(예산, 요금, 일정)은 마지막 장표에 따로 적습니다."
  }
 ]
}