# 저장소 최상위 .env 에 이미 있으면 따로 만들지 않아도 됩니다.
OPENAI_API_KEY=sk-...
# 생성(답변) 모델을 바꿀 때만 지정합니다(기본 gpt-4.1).
# OPENAI_CHAT_MODEL=gpt-4.1
# LLM 판사 모델을 바꿀 때만 지정합니다(기본 gpt-5.6-luna). 바꾸면 기준선을 새로 만듭니다.
# OPENAI_EVAL_MODEL=gpt-5.6-luna
# 교안 01의 '빠른 판사 Jev' 소절(선택)에서만 씁니다. 지난 단원 부록과 같은 키입니다.
# TYPESAFE_API_KEY=your_typesafe_api_key
# TYPESAFE_MODEL=jev-1.13.0
