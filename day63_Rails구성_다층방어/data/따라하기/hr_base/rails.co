define bot refuse to respond
  "죄송합니다. 이 요청에는 답변해 드릴 수 없습니다. 인사 문의는 인사팀 내선 2000으로 연락해 주세요."

define user express greeting
  "안녕하세요"
  "안녕"

define bot express greeting
  "안녕하세요. 누리전자 인사정보 도우미입니다. 무엇을 도와드릴까요?"

define flow greeting
  user express greeting
  bot express greeting

# 인사 질문: 봇 문장을 정해 두지 않아 LLM 이 검색 문서를 보고 답을 만든다
define user ask hr question
  "연차는 며칠이에요?"
  "경조 휴가 알려 주세요"
  "복지포인트는 어디에 쓰나요?"

# $check_facts: 출력 레일에 self check facts 를 켜면 이 흐름의 답변만 검색 문서와 대조한다
define flow hr question
  user ask hr question
  $check_facts = True
  bot answer hr question
