# 앞 단원의 OpenAI 설정을 재사용합니다. 저장소 최상위 .env 에 있으면 여기 다시 적지 않아도 됩니다.
OPENAI_API_KEY=your_openai_api_key
# NeMo Guardrails 의 모델은 data/본실습/card_base/config.yml 과 card_rails/config.yml 이 정합니다(gpt-4.1-mini, text-embedding-3-small).
# 라이브러리가 사용 기록을 외부로 보내지 않게 합니다(노트북 준비 셀에서도 설정합니다).
NEMO_GUARDRAILS_NO_USAGE_STATS=1
OTEL_SDK_DISABLED=true
# 부록(Hugging Face 게이트 모델 사용 신청)에서 다른 승인 모델을 직접 받을 때만 씁니다. 교안·과제에는 필요 없습니다.
HF_TOKEN=your_hf_read_token
