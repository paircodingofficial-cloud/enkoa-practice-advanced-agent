# 이 파일을 .env 로 복사한 뒤 키를 채웁니다(.env 는 git 에 올리지 않습니다)
# app/core/config.py 의 Settings 가 이 파일과 터미널 환경 변수를 읽습니다(같은 이름이면 환경 변수가 먼저입니다)
# 키가 비어 있으면 앱이 시작할 때 ValidationError 로 멈춥니다
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# 모델 이름(비워 두면 app/core/config.py 의 기본값을 씁니다)
OPENAI_CHAT_MODEL=gpt-5.6-luna
TYPESAFE_MODEL=jev-1.13.0
