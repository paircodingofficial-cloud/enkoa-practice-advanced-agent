# 앞 단원의 OpenAI 설정을 재사용합니다. 저장소 최상위 .env 에 있으면 여기 다시 적지 않아도 됩니다.
OPENAI_API_KEY=your_openai_api_key
# 교안 02 NeMo Guardrails 의 모델은 data/본실습/rails_first/ 의 config.yml(gpt-4.1-mini, text-embedding-3-small)과 prompts.yml 이 정합니다.
# NeMo Guardrails 가 익명 사용 통계를 NVIDIA 서버로 보내지 않게 합니다(노트북 준비 셀에서도 설정합니다).
NEMO_GUARDRAILS_NO_USAGE_STATS=1
